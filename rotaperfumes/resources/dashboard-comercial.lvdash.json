{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas (gold.fato_vendas)",
      "queryLines": [
        "SELECT ",
        "  data_pedido, ",
        "  ano, ",
        "  canal, ",
        "  segmento, ",
        "  cidade, ",
        "  uf, ",
        "  razao_social, ",
        "  marca, ",
        "  categoria, ",
        "  nota_olfativa, ",
        "  pedido_id, ",
        "  receita, ",
        "  margem ",
        "FROM fato_vendas"
      ],
      "columns": [
        {
          "displayName": "Receita Total",
          "description": "Receita liquida: ja desconta devolucao, que entra negativa no fato. Mesmo numero da silver.",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Margem Total",
          "description": "Receita menos custo do produto. Nao considera desconto comercial nem frete.",
          "expression": "SUM(`margem`)"
        },
        {
          "displayName": "Pedidos",
          "description": "Pedidos distintos, nao itens. Pedido cancelado nao entra no fato.",
          "expression": "COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Ticket Medio",
          "description": "Receita dividida por pedidos distintos.",
          "expression": "SUM(`receita`) / COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Margem %",
          "description": "Margem sobre receita, como razao de 0 a 1 para o formato percentual.",
          "expression": "SUM(`margem`) / SUM(`receita`)"
        }
      ]
    }
  ],
  "pages": [
    {
      "name": "comercial",
      "displayName": "Comercial",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "titulo",
            "textbox_spec": "# Rota Perfume · Visao Comercial"
          },
          "position": { "x": 0, "y": 0, "width": 12, "height": 1 }
        },
        {
          "widget": {
            "name": "subtitulo",
            "textbox_spec": "Receita liquida, margem e mix de venda sobre `gold.fato_vendas` — grao de item de pedido, sem pedido cancelado e com devolucao sinalizada. Este dashboard e um arquivo JSON versionado no bundle."
          },
          "position": { "x": 0, "y": 1, "width": 12, "height": 1 }
        },

        {
          "widget": {
            "name": "kpi_receita",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_vendas",
                  "fields": [
                    { "name": "measure(Receita Total)", "expression": "MEASURE(`Receita Total`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(Receita Total)",
                  "displayName": "Receita Total",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "BRL",
                    "abbreviation": "compact",
                    "decimalPlaces": { "type": "max", "places": 2 }
                  }
                }
              },
              "frame": { "title": "Receita liquida", "showTitle": true }
            }
